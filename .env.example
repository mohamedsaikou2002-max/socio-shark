# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Protect POST requests to /api/public/hooks/*
CRON_SECRET=replace-with-a-long-random-secret

# Stripe Payment Link for a $300 USD one-time payment and its webhook
VITE_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/your-payment-link
STRIPE_PAYMENT_LINK_ID=plink_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Social and generation APIs (also configurable in Settings → API tokens)
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=
