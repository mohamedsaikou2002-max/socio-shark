# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Protect POST requests to /api/public/hooks/*
CRON_SECRET=replace-with-a-long-random-secret

# Stripe monthly subscription Payment Links and webhook
VITE_STRIPE_PAYMENT_LINK_URL_1=https://buy.stripe.com/your-300-monthly-link
VITE_STRIPE_PAYMENT_LINK_URL_3=https://buy.stripe.com/your-500-monthly-link
VITE_STRIPE_PAYMENT_LINK_URL_5=https://buy.stripe.com/your-800-monthly-link
STRIPE_PAYMENT_LINK_ID_1=plink_replace_me
STRIPE_PAYMENT_LINK_ID_3=plink_replace_me
STRIPE_PAYMENT_LINK_ID_5=plink_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SECRET_KEY=sk_live_replace_me

# Social posting APIs (also configurable in Settings → API tokens)
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
TIKTOK_ACCESS_TOKEN=

# Gemini (server-only; never prefix with VITE_)
GEMINI_CAPTION_API_KEY=
GEMINI_STRATEGY_API_KEY=
GEMINI_CAPTION_MODEL=gemini-3.5-flash-lite
GEMINI_STRATEGY_MODEL=gemini-3.5-flash-lite
